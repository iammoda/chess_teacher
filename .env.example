OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
HOST=127.0.0.1
PORT=5173
ENABLE_REMOTE_HISTORY_ERASE=false

# Account auth + cloud sync. When all three are set, the app requires sign-in
# and syncs history through the server. Leave blank for local-only mode.
# Service role key: Supabase dashboard -> Project Settings -> API keys.
# NEVER expose the service role key to the browser or commit it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
